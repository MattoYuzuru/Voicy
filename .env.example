BOT_TOKEN=
# Existing API_TOKEN is accepted as a legacy alias.
ALLOWED_USER_IDS=
PUBLIC_BOT=false
DATA_DIR=data
PROFILES_FILE=config/profiles.json
MAX_AUDIO_SECONDS=600
JOB_TIMEOUT_SECONDS=900
RETENTION_DAYS=7
# ON optimizes Whisper for the build host CPU. Rebuild on a different target CPU.
WHISPER_NATIVE=OFF
# Configure profiles first, then add credentials here; never send keys to the bot.
# STT_API_KEY=
# OPENROUTER_API_KEY=
